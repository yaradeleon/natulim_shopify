# Obligatoria. Dominio sin https:// ni rutas; cambia el ejemplo si usas otra tienda.
SHOPIFY_SHOP_DOMAIN=natulim-sevica.myshopify.com
# Obligatoria. Client ID de la app instalada en la tienda.
SHOPIFY_CLIENT_ID=REEMPLAZAR_AQUI
# Obligatoria. Client Secret: se intercambia por un token en memoria.
SHOPIFY_CLIENT_SECRET=REEMPLAZAR_AQUI
# Opcional. Vacío usa SHOPIFY_CLIENT_SECRET para verificar webhooks de la app.
# Si la suscripción usa otro secreto de firma, indícalo en tu .env privado.
SHOPIFY_WEBHOOK_SECRET=
# Opcional. Valor por defecto: 2026-10.
SHOPIFY_API_VERSION=2026-10
# Opcional. Por defecto: data/shopify.db junto al proyecto.
DATABASE_PATH=data/shopify.db
